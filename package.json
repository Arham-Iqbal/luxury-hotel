{
  "name": "aurelia-stays",
  "private": true,
  "version": "1.0.0",
  "description": "Aurelia — luxury travel & hotel booking demo (Expo → APK + web + admin)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-expo-hoisting.mjs",
    "api": "tsx watch mock-api/src/server.ts",
    "web": "npm run web --workspace apps/mobile",
    "android": "npm run android --workspace apps/mobile",
    "export": "npm run export --workspace apps/mobile",
    "gen-api-data": "node scripts/gen-api-data.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "typecheck": "tsc --noEmit -p apps/mobile/tsconfig.json"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@vercel/node": "^3.2.24",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "express": "^4.21.2",
    "cors": "^2.8.5"
  }
}
